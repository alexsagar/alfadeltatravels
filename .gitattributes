# Line endings: store text as LF in the repository on every platform.
* text=auto eol=lf

# Binary assets: never normalised or diffed as text.
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.ico binary
*.avif binary
*.mp4 binary
*.webm binary
*.mov binary
*.lottie binary
*.wasm binary
*.glb binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary

# SVG stays text (diffable), LF.
*.svg text eol=lf
