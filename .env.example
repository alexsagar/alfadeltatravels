# Copy to .env.local. None of these are secrets.
# Sanity is the only content source (see docs/SANITY_SETUP.md). Both are
# required; the build fails with a clear message without them.
NEXT_PUBLIC_SANITY_PROJECT_ID=4qnp14bk
# No default. Local work, CI and the client-review site: development.
# "production" is locked (src/sanity/guard.ts); only a future production
# deployment may read it, by also setting SANITY_ALLOW_PRODUCTION_READ=true.
NEXT_PUBLIC_SANITY_DATASET=development
# Optional: pinned Sanity API date
# NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
# Real public origin. Unset = localhost canonicals and robots.txt blocks crawling.
NEXT_PUBLIC_SITE_URL=
