# Copy to .env.local. None of these are secrets.
# Sanity (see docs/SANITY_SETUP.md). Unset project id = local content fallback.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Required when a project id is set; no default. Local work: development.
# "production" is locked (src/sanity/guard.ts); only the production deployment
# may read it, by also setting SANITY_ALLOW_PRODUCTION_READ=true.
NEXT_PUBLIC_SANITY_DATASET=development
# Optional: pinned Sanity API date
# NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
# Real public origin. Unset = localhost canonicals and robots.txt blocks crawling.
NEXT_PUBLIC_SITE_URL=

# Content types that read Sanity instead of local content (comma-separated:
# treks, destinations, experiences, home). Unset = all local. Set a type only
# after ALL of its documents are published. See docs/SANITY_SETUP.md.
SANITY_CUTOVER=
